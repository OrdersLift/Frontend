---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  keywords?: string;
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  type?: string;
}

const { 
  title, 
  description = "OrdersLift builds restaurant websites with commission-free table booking, a QR digital menu you update in seconds, and an AI assistant that answers guests around the clock. Hosted and maintained for 2 years free.",
  image = "https://orderslift.co.in/og-image.jpg",
  canonical = Astro.url.href,
  keywords = "restaurant website design, restaurant website agency, table booking system for restaurants, restaurant reservation system, QR menu, QR code menu for restaurants, digital menu, restaurant online ordering, commission free bookings, cafe website design, takeaway website design, pub and bar website, restaurant SEO, restaurant AI chatbot",
  author = "OrdersLift",
  publishedTime,
  modifiedTime,
  section = "Restaurant Technology",
  type = "website"
} = Astro.props;

const siteName = "OrdersLift";
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;

// The OrdersLift assistant appears on marketing pages only — demo pages under
// /demo/* render their own brand-specific chat widgets.
import AIChat from '../components/AIChat';
import LiveChat from '../components/LiveChat';
const showAssistant = !Astro.url.pathname.startsWith('/demo');

// Individual demo sites carry their own fixed brand palettes, so the
// orange/yellow light-dark theme is locked to light there. The demo index
// (/demo) is part of the marketing site and follows the theme normally.
const demoBrandPath = /^\/demo\/.+/.test(Astro.url.pathname);
---

<!DOCTYPE html>
<!-- Dark is the only theme. `demoBrandPath` is known during render, so the
     class is set here rather than by a script — no flash, no client JS. Demo
     sites under /demo/* keep their own light brand palettes. -->
<html
  lang="en"
  class={`scroll-smooth ${demoBrandPath ? '' : 'dark'}`}
  data-theme={demoBrandPath ? 'light' : 'dark'}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    <meta name="theme-color" content="#f97316" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />

    <!-- Language and Region -->
    <meta name="language" content="English" />
    <meta name="geo.region" content="Worldwide" />
    <meta name="geo.placename" content="Global" />
    <meta name="geo.position" content="Global" />
    <meta name="ICBM" content="Global" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="OrdersLift — Restaurant Websites, Table Booking & QR Menus" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="en_GB" />
    <meta property="og:locale:alternate" content="en_CA" />
    <meta property="og:locale:alternate" content="en_AU" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta property="article:section" content={section} />
    
    <!-- Hreflang for International SEO -->
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="en-us" href={canonical} />
    <link rel="alternate" hreflang="en-gb" href={canonical} />
    <link rel="alternate" hreflang="en-ca" href={canonical} />
    <link rel="alternate" hreflang="en-au" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />
    <meta property="twitter:image:alt" content="OrdersLift — Restaurant Websites, Table Booking & QR Menus" />
    <meta property="twitter:creator" content="@orderslift" />
    <meta property="twitter:site" content="@orderslift" />
    
    <!-- Preconnect to external domains -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Google Fonts -->
    <!-- Must stay in step with `fontFamily` in tailwind.config.mjs: anything
         named there and not requested here silently renders as system-ui. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500..700&family=Inter:wght@300..700&family=IBM+Plex+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "OrdersLift",
      "url": "https://orderslift.co.in",
      "logo": "https://orderslift.co.in/logo.png",
      "description": description,
      "foundingDate": "2023",
      "industry": "Restaurant Technology",
      "numberOfEmployees": "10-50",
      "globalServiceArea": true,
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "Global"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+91-63939-74340",
        "contactType": "customer service",
        "email": "restaurantorderlift@gmail.com",
        "availableLanguage": "English, Spanish, French, German, Hindi, Chinese"
      },
      "sameAs": [
        "https://twitter.com/orderslift",
        "https://linkedin.com/company/orderslift",
        "https://facebook.com/orderslift"
      ],
      "serviceArea": {
        "@type": "Place",
        "name": "Worldwide",
        "description": "Global restaurant technology services"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Restaurant Website, Booking & Menu Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Restaurant Website Design & Rebuild",
              "description": "Custom restaurant websites, built new or rebuilt from an existing site, with a self-serve admin panel"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Table Booking System",
              "description": "Commission-free online table reservations with automatic confirmations and reminders"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "QR Digital Menu",
              "description": "Scannable QR menu that restaurant owners can update instantly from a phone"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "AI Menu & Booking Assistant",
              "description": "24/7 chatbot trained on the restaurant's menu and hours that answers guests and takes bookings"
            }
          }
        ]
      }
    })} />
    
    <!-- Local Business Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "OrdersLift",
      "description": "Restaurant website, table booking and QR menu agency",
      "url": "https://orderslift.co.in",
      "telephone": "+91-63939-74340",
      "email": "restaurantorderlift@gmail.com",
      "priceRange": "$$",
      "currenciesAccepted": "USD, EUR, GBP, CAD, AUD, INR",
      "paymentAccepted": "Credit Card, PayPal, Bank Transfer, Stripe, Apple Pay, Google Pay",
      "areaServed": "Worldwide",
      "serviceType": "Restaurant Website, Booking & QR Menu Services",
      "openingHours": "Mo-Su 00:00-23:59"
    })} />

    <!-- Demo brand sites load their own typefaces here. -->
    <slot name="head" />
  </head>
  <body class="font-sans antialiased bg-paper text-body transition-colors duration-300">
    <slot />
    {showAssistant && <AIChat client:load />}
    {showAssistant && <LiveChat client:load />}
  </body>
  
  <!-- Global Styles -->
  <style is:global>
    @import '../styles/global.css';
  </style>
</html> 