---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  keywords?: string;
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  type?: string;
}

const { 
  title, 
  description = "OrdersLift is a growth marketing agency for restaurants and nothing else — Google Business Profile rebuilds, a review engine that brings in real reviews, branded review-request emails, and Meta ads that fill quiet nights.",
  image = "https://orderslift.com/og-image.jpg",
  canonical = Astro.url.href,
  keywords = "restaurant marketing agency, restaurant Google Business Profile, get more Google reviews for restaurants, restaurant review management, restaurant reputation management, review request emails, restaurant Facebook ads, restaurant Instagram ads, Meta ads for restaurants, local SEO for restaurants, restaurant map pack, direct online ordering",
  author = "OrdersLift",
  publishedTime,
  modifiedTime,
  section = "Restaurant Marketing",
  type = "website"
} = Astro.props;

const siteName = "OrdersLift";
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;

// The OrdersLift assistant appears on marketing pages only — demo pages under
// /demo/* render their own brand-specific chat widgets.
import AIChat from '../components/AIChat';
const showAssistant = !Astro.url.pathname.startsWith('/demo');

// Individual demo sites carry their own fixed brand palettes, so the
// orange/yellow light-dark theme is locked to light there. The demo index
// (/demo) is part of the marketing site and follows the theme normally.
const demoBrandPath = /^\/demo\/.+/.test(Astro.url.pathname);
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#100e0b" media="(prefers-color-scheme: dark)" />

    <!-- Applies the saved / system colour scheme before first paint so the
         page never flashes the wrong theme. -->
    <script is:inline define:vars={{ demoBrandPath }}>
      (() => {
        const root = document.documentElement;
        if (demoBrandPath) {
          root.classList.remove('dark');
          root.dataset.theme = 'light';
          return;
        }
        let saved = null;
        try { saved = localStorage.getItem('theme'); } catch {}
        const theme =
          saved === 'dark' || saved === 'light'
            ? saved
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        root.classList.toggle('dark', theme === 'dark');
        root.dataset.theme = theme;
      })();
    </script>
    
    <!-- Language and Region -->
    <meta name="language" content="English" />
    <meta name="geo.region" content="Worldwide" />
    <meta name="geo.placename" content="Global" />
    <meta name="geo.position" content="Global" />
    <meta name="ICBM" content="Global" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="OrdersLift — growth marketing for restaurants" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="en_GB" />
    <meta property="og:locale:alternate" content="en_CA" />
    <meta property="og:locale:alternate" content="en_AU" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta property="article:section" content={section} />
    
    <!-- Hreflang for International SEO -->
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="en-us" href={canonical} />
    <link rel="alternate" hreflang="en-gb" href={canonical} />
    <link rel="alternate" hreflang="en-ca" href={canonical} />
    <link rel="alternate" hreflang="en-au" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />
    <meta property="twitter:image:alt" content="OrdersLift — growth marketing for restaurants" />
    <meta property="twitter:creator" content="@orderslift" />
    <meta property="twitter:site" content="@orderslift" />
    
    <!-- Preconnect to external domains -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Google Fonts
         Archivo carries a width axis — the display face is set narrow and
         heavy, which is how menu boards and restaurant signage are lettered.
         Plex Sans for reading, Plex Mono for every figure on the page. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..100,600..800&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "OrdersLift",
      "url": "https://orderslift.com",
      "logo": "https://orderslift.com/logo.png",
      "description": description,
      "foundingDate": "2023",
      "industry": "Restaurant Marketing",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+91-63939-74340",
        "contactType": "sales",
        "email": "restaurantorderlift@gmail.com",
        "availableLanguage": "English"
      },
      "sameAs": [
        "https://twitter.com/orderslift",
        "https://linkedin.com/company/orderslift",
        "https://facebook.com/orderslift"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Restaurant growth marketing services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Google Business Profile management",
              "description": "Rebuilding and maintaining a restaurant's Google Business Profile — categories, attributes, hours, menu, ordering links and photography."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Review generation and reputation management",
              "description": "A review engine that asks every guest once, timed to their visit, plus same-day replies to every review."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Review-request email and SMS campaigns",
              "description": "Branded review-request messages sent from the restaurant's own address a few hours after the meal."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Facebook and Instagram advertising",
              "description": "Local Meta ad campaigns built around a redeemable offer, reported on cost per redeemed voucher."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Restaurant website and direct online ordering",
              "description": "Menu, ordering and table booking on the restaurant's own domain, commission free."
            }
          }
        ]
      }
    })} />
    
    <!-- Local Business Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "OrdersLift",
      "description": "Growth marketing agency for restaurants — Google Business Profile, reviews, email and Meta ads.",
      "url": "https://orderslift.com",
      "telephone": "+91-63939-74340",
      "email": "restaurantorderlift@gmail.com",
      "priceRange": "$$",
      "areaServed": "Worldwide",
      "serviceType": "Restaurant marketing",
      "audience": {
        "@type": "BusinessAudience",
        "name": "Restaurants, cafés, bars and takeaways"
      }
    })} />
    <slot name="head" />
  </head>
  <body class="font-sans antialiased bg-paper text-body">
    <slot />
    {showAssistant && <AIChat client:load />}
  </body>
  
  <!-- Global Styles -->
  <style is:global>
    @import '../styles/global.css';
  </style>
</html> 