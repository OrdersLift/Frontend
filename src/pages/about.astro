---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import About from '../components/About';
import Contact from '../components/Contact';
import Footer from '../components/Footer';
---

<Layout
  title="About OrdersLift — A Growth Agency for Restaurants Only"
  description="OrdersLift works with restaurants, cafés, bars and takeaways and nothing else. Here is how we work, what we measure, and the six things we refuse to do."
  keywords="restaurant marketing agency about, restaurant growth agency, restaurant reputation agency, restaurant only marketing"
  canonical="https://orderslift.com/about"
  type="article"
  section="About"
>
  <Header client:load />
  <main>
    <About />
    <Contact client:visible />
  </main>
  <Footer client:visible />
</Layout>
