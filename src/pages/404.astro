---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';

const elsewhere = [
  { name: 'What we do',       href: '/#services',            note: 'Reviews, profile, email, ads, site' },
  { name: 'The work',         href: '/#work',                note: 'Before and after, side by side' },
  { name: 'Pricing',          href: '/#pricing',             note: 'Three shapes, month to month' },
  { name: 'Demo restaurant',  href: '/demo/restaurants/',    note: 'A working site you can click through' },
  { name: 'Book a teardown',  href: '/#contact',             note: 'Twenty minutes, free, no deck' },
];
---

<Layout
  title="Page not found"
  description="That page is not here. The listing, the work, the pricing and the demo restaurant all are."
  canonical="https://orderslift.com/404"
>
  <Header client:load />

  <main class="flex min-h-[70vh] items-center pt-28">
    <div class="shell">
      <p class="label">404</p>
      <h1 class="display mt-5 max-w-2xl text-[clamp(2.4rem,6vw,3.8rem)]">
        Nothing on the menu at this address.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-body">
        The page moved or never existed. Everything worth reading is one of these.
      </p>

      <ul class="mt-12 max-w-2xl border-t border-rule">
        {elsewhere.map((l) => (
          <li class="border-b border-rule">
            <a
              href={l.href}
              class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1 py-4 transition-colors hover:text-ink"
            >
              <span class="display text-lg">{l.name}</span>
              <span class="text-sm text-muted">{l.note}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>

  <Footer client:visible />
</Layout>
