---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Hero from '../components/Hero';
import TrustedBy from '../components/TrustedBy';
import Features from '../components/Features';
import Results from '../components/Results';
import Work from '../components/Work';
import HowItWorks from '../components/HowItWorks';
import Pricing from '../components/Pricing';
import Reviews from '../components/Reviews';
import FAQ from '../components/FAQ';
import CTABanner from '../components/CTABanner';
import Contact from '../components/Contact';
import Footer from '../components/Footer';
---

<Layout
  title="OrdersLift - Restaurant Marketing, Analytics & Automation"
  description="OrdersLift grows restaurants with data-driven marketing, analytics dashboards, menu optimization, inventory insights, reputation management and automation. Book a free strategy call."
  keywords="restaurant marketing agency, restaurant analytics, menu optimization, restaurant automation, restaurant reputation management, google reviews for restaurants, restaurant growth marketing, restaurant inventory insights"
  canonical="https://orderslift.com/"
>
  <Header client:load />
  <Hero client:load />
  <TrustedBy client:visible />
  <Features client:visible />
  <Results client:visible />
  <Work client:visible />
  <HowItWorks client:visible />
  <Pricing client:visible />
  <Reviews client:visible />
  <FAQ client:visible />
  <CTABanner client:visible />
  <Contact client:visible />
  <Footer client:visible />
</Layout>
