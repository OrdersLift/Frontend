---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';

const pages = [
  { name: 'Home',         href: '/demo/restaurants/',              note: 'Story, hours, signature dishes' },
  { name: 'Menu',         href: '/demo/restaurants/menu',          note: 'Full menu, filterable, allergen tags' },
  { name: 'Order',        href: '/demo/restaurants/order',         note: 'Direct ordering, no commission' },
  { name: 'Reservations', href: '/demo/restaurants/reservations',  note: 'Table booking with covers and time' },
  { name: 'About',        href: '/demo/restaurants/about',         note: 'The people, the room, the sourcing' },
];
---

<Layout
  title="Demo Restaurant — Saffron & Ember"
  description="A complete working restaurant site: menu, direct ordering, table booking and an on-site assistant. Built by OrdersLift as a live example of what a restaurant gets."
  canonical="https://orderslift.com/demo/"
>
  <Header client:load />

  <main>
    <section class="pb-4 pt-28 sm:pt-32 lg:pt-40">
      <div class="shell">
        <p class="label">Demo</p>
        <h1 class="display mt-5 max-w-3xl text-[clamp(2.4rem,6vw,3.8rem)]">
          Saffron &amp; Ember, open for business.
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-body">
          A restaurant that does not exist, with a site that entirely does. Menu, direct ordering,
          table booking and an assistant that knows the menu — all of it working, none of it a
          screenshot. This is the site half of what we build; the reviews, email and ads sit on
          top of it.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/demo/restaurants/" class="btn btn-solid">Open the demo</a>
          <a href="/#contact" class="btn btn-line">Book a teardown</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="shell">
        <ul class="border-t border-rule">
          {pages.map((p) => (
            <li class="border-b border-rule">
              <a
                href={p.href}
                class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1 py-5 transition-colors hover:text-ink"
              >
                <span class="display text-xl">{p.name}</span>
                <span class="text-sm text-muted">{p.note}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <Footer client:visible />
</Layout>
