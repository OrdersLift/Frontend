---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';

const demos = [
  { slug: 'restaurants', brand: 'Saffron & Ember', tagline: 'Indo-Mediterranean wood-fire dining', emoji: '🔥', industry: 'Restaurant', accent: 'from-primary-400/25 to-primary-600/20', ring: 'hover:border-glow-500/60' },
  { slug: 'burger-blaze', brand: 'Burger Blaze', tagline: 'Quick-service burgers — build-your-own, AI combos and live order tracking', emoji: '🍔', industry: 'Quick Service', accent: 'from-accent-400/25 to-primary-500/20', ring: 'hover:border-accent-500/60' },
  { slug: 'prime-table', brand: 'Prime Table', tagline: 'Modern steakhouse — live reservations, digital menu and private events', emoji: '🥩', industry: 'Fine Dining', accent: 'from-glow-500/25 to-neutral-700/20', ring: 'hover:border-glow-400/60' },
];
---

<Layout
  title="Live Demos — See What OrdersLift Builds"
  description="Explore three live, interactive demos of the restaurant websites OrdersLift builds — fine dining, quick service and steakhouse, each with online ordering, table reservations, a QR menu and a built-in AI chat widget."
  canonical="https://orderslift.co.in/demo/"
>
  <Header client:load />

  <main class="relative min-h-screen bg-white dark:bg-black overflow-hidden">
    <div class="absolute inset-0 grid-bg opacity-40 pointer-events-none"></div>
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary-300/30 dark:bg-primary-600/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-accent-300/30 dark:bg-glow-600/15 rounded-full blur-3xl pointer-events-none"></div>

    <section class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-36 pb-24">
      <!-- Header -->
      <div class="text-center mb-16">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass border border-primary-500/30 text-primary-600 dark:text-primary-300 text-sm font-medium mb-6">
          ✨ Live Interactive Demos
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold text-neutral-900 dark:text-white mb-5">
          See What We Build —{' '}
          <span class="gradient-text">For Restaurants</span>
        </h1>
        <p class="text-lg text-neutral-600 dark:text-slate-400 max-w-3xl mx-auto leading-relaxed">
          Three complete restaurant websites, each with its own brand, online ordering, table
          reservations and a built-in AI chat widget — exactly the kind of site we build for you.
          Click through and try them live.
        </p>
      </div>

      <!-- Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-md sm:max-w-none mx-auto">
        {demos.map((d) => (
          <a
            href={`/demo/${d.slug}/`}
            class={`group relative rounded-2xl border border-primary-200/70 dark:border-white/[0.08] bg-gradient-to-br ${d.accent} p-7 flex flex-col card-hover transition-all duration-300 ${d.ring}`}
          >
            <div class="flex items-center justify-between mb-5">
              <div class="w-14 h-14 rounded-2xl bg-cream-200 dark:bg-white/[0.08] border border-primary-200/70 dark:border-white/10 flex items-center justify-center text-3xl">
                {d.emoji}
              </div>
              <span class="text-xs font-semibold px-3 py-1 rounded-full bg-cream-200 dark:bg-white/[0.08] text-neutral-700 dark:text-slate-300 border border-primary-200/70 dark:border-white/10">
                {d.industry}
              </span>
            </div>
            <h2 class="text-xl font-bold text-neutral-900 dark:text-white mb-1.5">{d.brand}</h2>
            <p class="text-neutral-600 dark:text-slate-400 text-sm leading-relaxed mb-6">{d.tagline}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 text-sm font-semibold text-primary-600 dark:text-primary-300 group-hover:text-primary-700 dark:group-hover:text-primary-200 transition-colors">
              Explore demo
              <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
            </span>
          </a>
        ))}
      </div>

      <!-- CTA -->
      <div class="text-center mt-16">
        <p class="text-neutral-600 dark:text-slate-400 text-sm mb-5">Want to see this built around your own menu?</p>
        <a href="/#contact" class="btn-primary text-base px-8 py-4 glow-primary">
          Start Your Project →
        </a>
      </div>
    </section>
  </main>
</Layout>
