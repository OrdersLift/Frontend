# Google Gemini API key for the site chatbots (free tier).
# Get one at https://aistudio.google.com/apikey
#
# Local dev: copy this file to `.env` and paste your key below.
# Netlify:   add GEMINI_API_KEY under Site settings → Environment variables.
GEMINI_API_KEY=your-gemini-api-key-here

# Public base URL of the Go live-chat backend (../Backend). Client-side, so it
# must keep the PUBLIC_ prefix. Leave unset and the "Talk to the team" widget
# simply doesn't render.
PUBLIC_CHAT_API=http://localhost:8080
